# ==========================================
# CONFIGURACIÓN DEL BOT DE WHATSAPP (GASTOS)
# ==========================================

# 1. Google Gemini API (obtén tu API key gratuita en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash

# 2. Tu número de teléfono personal (Seguridad: con código de país, sin '+' ni guiones ni espacios)
# Ejemplo para España (+34 612 34 56 78): 34612345678
# Ejemplo para México (+52 1 55...): 5215512345678
# Ejemplo para Argentina (+54 9 11...): 5491112345678
ALLOWED_PHONE_NUMBER=34612345678

# 3. Google Sheets
# ID extraído de la URL: https://docs.google.com/spreadsheets/d/TU_SPREADSHEET_ID/edit
SPREADSHEET_ID=tu_spreadsheet_id_aqui

# Nombre de la pestaña donde se guardan los datos (por defecto 'Movimientos' o 'Hoja 1')
SHEET_NAME=Movimientos

# 4. Credenciales de la Service Account de Google
# Ruta al archivo JSON descargado desde Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# (Opcional) Alternativa para despliegue en la nube o Docker sin montar archivo:
# Pega el contenido JSON completo de la clave de la cuenta de servicio en una sola línea:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# 5. Parámetros Generales
WHATSAPP_AUTH_DIR=./auth_session
CURRENCY_SYMBOL=$
